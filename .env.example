# ══════════════════════════════════════════════════
# SpeakLife AI — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ══════════════════════════════════════════════════

# === Application ===
APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=SpeakLife AI
NEXT_PUBLIC_APP_VERSION=2.0.0
NODE_ENV=development

# === Database ===
# Default is SQLite local file
DATABASE_PATH=./data/speaklife.db
# Or remote database URL:
# DATABASE_URL=file:./data/speaklife.db

# === Authentication ===
# REQUIRED: Generate a secure secret (min 32 chars) with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-32-character-or-longer-secret-key-here
JWT_EXPIRY=24h
# Alternatively for NextAuth compatibility:
# NEXTAUTH_SECRET=your-32-character-or-longer-secret-key-here

# === Google Gemini AI ===
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
