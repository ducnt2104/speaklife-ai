# SpeakLife AI — Production .gitignore
# Next.js 14 App Router, TypeScript, Tailwind, Node.js

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Outputs & Caches
/.next/
/out/
/build
/dist

# TypeScript Incremental Cache
*.tsbuildinfo
next-env.d.ts.bak

# Testing & Coverage Artifacts
/coverage
/.nyc_output

# Environment Variables & Secrets (Security Rule - Zero Leakage)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs & Diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo

# Vercel Deployment Artifacts
.vercel
